{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@display/*": ["./src/*"],
      "@phone/*": ["../phone/src/*"],
      "@game-platform/*": ["../server/src/games/*"],
      "@boredless/shared": ["../packages/shared/src/index.ts"]
    }
  },
  "include": ["src", "../games"]
}
